  * Copyright The KiCad Developers, see AUTHORS.txt for contributors.
+ *
+ * Modified by the typmax-router authors, 2026-10-07: ArcHull's margin covers
+ *   its polyline's error
+ *   (patches/0002-archull-margin-covers-polyline-error.patch in the typmax-router repository).
  * Author: Tomasz Wlostowski <tomasz.wlostowski@cern.ch>
  *
  * This program is free software: you can redistribute it and/or modify it
@@ -79,7 +83,12 @@
                               2.0 * ( 1.0 - M_SQRT1_2 ) * ( r + cl ) );
     }
 
-    int d = aArc.GetWidth() / 2 + cl + SHAPE_ARC::DefaultAccuracyForPCB();
+    // The hull offsets the arc's polyline, not the arc. ConvertToPolyline splits its
+    // error on either side of the arc (vertices error/2 outside, chord midpoints
+    // error/2 inside), so on either side the hull can come up to ARC_LOW_DEF / 2
+    // closer to the arc than the clearance. The margin covers that, plus 1 um for the
+    // integer rounding of the vertices, the offsets and the miter points (each ~1 nm).
+    int d = aArc.GetWidth() / 2 + cl + ARC_LOW_DEF / 2 + pcbIUScale.mmToIU( 0.001 );
     int x = (int) ( 2.0 / ( 1.0 + M_SQRT2 ) * d ) / 2;
 
     auto line = aArc.ConvertToPolyline( ARC_LOW_DEF );
