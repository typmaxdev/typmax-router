+    double SIN_22_5 = 0.41421;   // tan(22.5)
+    double SIN_23_5 = 0.42500;   // a little above tan(22.5): wiggle room
 
     auto addAngledGateways =
             [&]( int length, int priority )
@@ -670,7 +677,9 @@
 
     VECTOR2I delta = aPair.AnchorP() - aPair.AnchorN();
 
-    if( abs( delta.x ) < EPSILON || abs( delta.y ) < EPSILON || abs( delta.x - delta.y ) < EPSILON )
+    // Either 45-degree diagonal: delta.x == delta.y caught only one of the two.
+    if( abs( delta.x ) < EPSILON || abs( delta.y ) < EPSILON
