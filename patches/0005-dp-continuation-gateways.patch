@@ -645,8 +649,11 @@
     // the existing direction.
 
     int    EPSILON  = 5;         // 0.005um
-    double SIN_22_5 = 0.38268;   // sin(22.5)
-    double SIN_23_5 = 0.39875;   // sin(23.5)
+    // The outer member of a pair turning 45 degrees leads the inner by the pitch times
