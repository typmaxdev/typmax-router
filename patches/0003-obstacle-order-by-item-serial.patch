@@ -102,11 +106,19 @@
 
     bool operator<(const OBSTACLE& other) const
     {
-        if( (uintptr_t)m_head < (uintptr_t)other.m_head )
-            return true;
-        else if ( m_head == other.m_head )
-            return (uintptr_t)m_item < (uintptr_t)other.m_item;
-        return false;
+        // Order by creation, not by address: the address order changes from run to run
+        // (ASLR, allocator state), and with it which of two equally near obstacles
+        // NearestObstacle and the cluster walk take first. No two live items share a
+        // serial (assignment keeps the target's), so the address comparison below is
+        // only a total order's formality.
+        auto key = []( const ITEM* i ) -> uint64_t { return i ? i->Serial() : 0; };
+        if( key( m_head ) != key( other.m_head ) )
+            return key( m_head ) < key( other.m_head );
+        if( key( m_item ) != key( other.m_item ) )
+            return key( m_item ) < key( other.m_item );
+        if( m_head != other.m_head )
+            return (uintptr_t)m_head < (uintptr_t)other.m_head;
+        return (uintptr_t)m_item < (uintptr_t)other.m_item;
     }
