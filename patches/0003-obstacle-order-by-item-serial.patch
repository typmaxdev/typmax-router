+    /**
+     * Assignment copies everything the implicit one did except the serial: the target
+     * stays the item it was (its place in serial-ordered containers), so no two live
+     * items share a serial and OBSTACLE never needs its address tie-break.
+     */
+    ITEM& operator=( const ITEM& aOther )
+    {
+        if( this == &aOther )
+            return *this;
+
+        OWNABLE_ITEM::operator=( aOther );
+        ITEM_OWNER::operator=( aOther );
+        m_kind = aOther.m_kind;
+        m_parent = aOther.m_parent;
+        m_sourceItem = aOther.m_sourceItem;
+        m_layers = aOther.m_layers;
+        m_movable = aOther.m_movable;
+        m_net = aOther.m_net;
+        m_marker = aOther.m_marker;
+        m_rank = aOther.m_rank;
+        m_routable = aOther.m_routable;
+        m_isVirtual = aOther.m_isVirtual;
+        m_isFreePad = aOther.m_isFreePad;
+        m_isCompoundShapePrimitive = aOther.m_isCompoundShapePrimitive;
+        return *this;
+    }
+
     virtual ~ITEM();
 
     /**
+     * A number that orders items by creation (a copy is a new item; an assignment keeps
+     * the target's). Unlike the item's
+     * address, it does not depend on where the allocator put the item, so containers
+     * ordered by it iterate the same way in every run.
+     */
+    uint64_t Serial() const { return m_serial; }
