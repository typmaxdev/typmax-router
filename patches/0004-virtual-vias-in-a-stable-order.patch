@@ -58,9 +62,10 @@
             using std::hash;
             using std::string;
 
-            return ( (hash<int>()( aP.pos.x )
-                      ^ (hash<int>()( aP.pos.y ) << 1) ) >> 1 )
-                   ^ (hash<void*>()( aP.net ) << 1);
+            // The position only: the net is a pointer, whose value (and so the table's
+            // iteration order) changes from run to run. Equality still compares the net;
+            // joints of two nets at one position merely share a bucket.
+            return ( hash<int>()( aP.pos.x ) ^ ( hash<int>()( aP.pos.y ) << 1 ) ) >> 1;
         }
     };
 
