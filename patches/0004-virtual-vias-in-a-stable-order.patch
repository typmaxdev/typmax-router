+    // m_joints is a hash table: its order differs between standard libraries. Add the
+    // virtual vias in an order of their own (position, layer, diameter), since their
+    // serials, and so their order as obstacles, follow the order they are added in.
+    std::stable_sort( vvias.begin(), vvias.end(),
+                      []( const VVIA* a, const VVIA* b )
+                      {
+                          const int la = a->Layers().Start(), lb = b->Layers().Start();
+                          return std::make_tuple( a->Pos().x, a->Pos().y, la, a->Diameter( la ) )
+                                 < std::make_tuple( b->Pos().x, b->Pos().y, lb, b->Diameter( lb ) );
+                      } );
 
     for( auto vvia : vvias )
     {
