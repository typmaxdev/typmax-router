@@ -1647,7 +1651,8 @@
              iface->GetNetName( currentLine.Net() ),
              currentLine.EndsWithVia() ? 1 : 0 ) );
 
-    for( ITEM::PnsKind search_order : { ITEM::SOLID_T, ITEM::VIA_T, ITEM::SEGMENT_T, ITEM::HOLE_T } )
